NODE_ENV=development
PORT=3000
DB_PATH=./data/watchtower.db
SQLITE_BUSY_TIMEOUT_MS=5000
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ADMIN_OID=00000000-0000-0000-0000-000000000000
CORS_ORIGINS=http://localhost:5173
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_DEFAULT_RESOURCE_GROUP=
AZURE_REQUEST_TIMEOUT_MS=20000
UNIFI_INGEST_TOKEN=
UPS_INGEST_TOKEN=
PROTECT_INGEST_TOKEN=
SYNOLOGY_INGEST_TOKEN=
SONARR_INGEST_TOKEN=
NETWORK_OBSERVER_INGEST_TOKEN=
AGENT_LOG_INGEST_TOKEN=
MOBILE_API_TOKEN=
MARQUEE_BASE_URL=
MARQUEE_TENANT_ID=
MARQUEE_CLIENT_ID=
# Development/test only. Production uses managed identity.
MARQUEE_CLIENT_SECRET=
MARQUEE_SCOPE=api://marquee/.default
MARQUEE_TIMEOUT_MS=5000
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=production
APNS_CRITICAL_ALERTS=false
APNS_ALERT_TTL_SECONDS=3600
ALERT_ENGINE_ENABLED=true
ALERT_POLL_SECONDS=60
OUTAGE_POSTMORTEM_ENABLED=true
OUTAGE_POSTMORTEM_STARTUP_DELAY_SECONDS=60
NETWORK_OBSERVER_ALERT_FAILURE_SAMPLES=3
NETWORK_OBSERVER_ALERT_RECOVERY_SAMPLES=3
MONITORING_ARCHIVE_ACCOUNT=
MONITORING_ARCHIVE_CONTAINER=watchtower-monitoring
MONITORING_ARCHIVE_SETTLE_HOURS=6
MONITORING_ARCHIVE_INTERVAL_HOURS=6
MONITORING_ARCHIVE_MAX_DAYS_PER_RUN=7
MONITORING_ARCHIVE_LEASE_MS=1800000
OFFHOST_BACKUP_ENABLED=false
OFFHOST_BACKUP_ACCOUNT=
OFFHOST_BACKUP_CONTAINER=watchtower-backups
OFFHOST_BACKUP_PREFIX=watchtower
BACKUP_ROOT=/home/data/backups/watchtower
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=2
OFFHOST_BACKUP_START_DELAY_MS=60000
OFFHOST_BACKUP_RETRY_DELAY_MS=60000
OFFHOST_BACKUP_REQUEST_TIMEOUT_MS=900000
OFFHOST_BACKUP_VERIFY_RESTORE=true
